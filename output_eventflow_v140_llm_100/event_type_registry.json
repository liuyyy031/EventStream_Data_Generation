{
  "registry_id": "streasoner.transportation.road",
  "registry_version": "2.0.0",
  "domain": "transportation",
  "subdomain": "road",
  "scope": "road-traffic event-flow generation; not rail, aviation, maritime, or full public transit",
  "categories": {
    "environmental_condition": "Environmental conditions that can affect road traffic.",
    "traffic_incident": "Unplanned incidents involving road users or vehicles.",
    "obstruction": "Physical obstructions on a road segment.",
    "equipment_fault": "Failures of traffic-control equipment or systems.",
    "operator_action": "Actions initiated by or on behalf of a road operator.",
    "traffic_state_change": "Point events that mark a change in traffic-flow state."
  },
  "design_sources": [
    {
      "title": "DATEX II Situation and SituationPublication",
      "url": "https://docs.datex2.eu/v3.1/level2user/situationPublication.html",
      "supports": "Separation of traffic elements, operator actions, environmental conditions, faults, obstructions and abnormal traffic."
    },
    {
      "title": "GTFS Realtime Service Alerts",
      "url": "https://gtfs.org/documentation/realtime/feed-entities/service-alerts/",
      "supports": "Separation of disruption causes from their effects on a transport service."
    }
  ],
  "event_types": {
    "transportation.road.environment.heavy_rain_onset": {
      "display_name": "heavy rain onset",
      "category": "environmental_condition",
      "definition": "The point at which heavy rainfall begins to affect the represented region.",
      "participant_roles": {
        "affected_region": {
          "entity_types": [
            "region"
          ],
          "min_count": 1,
          "max_count": 1
        }
      },
      "attributes": {
        "required": {
          "intensity_mm_per_hour": {
            "type": "number",
            "minimum": 0.0
          },
          "coverage": {
            "type": "string",
            "enum": [
              "regional"
            ]
          },
          "capacity_reduction_fraction": {
            "type": "number",
            "minimum": 0.0,
            "maximum": 1.0
          }
        },
        "optional": {},
        "additional_properties": false
      },
      "external_mappings": [
        {
          "standard": "DATEX_II",
          "concept": "Conditions.EnvironmentConditions.Precipitation"
        }
      ]
    },
    "transportation.road.obstruction.flooding_onset": {
      "display_name": "road flooding onset",
      "category": "obstruction",
      "definition": "The point at which flooding starts to obstruct a represented road segment.",
      "participant_roles": {
        "affected_road": {
          "entity_types": [
            "road_segment"
