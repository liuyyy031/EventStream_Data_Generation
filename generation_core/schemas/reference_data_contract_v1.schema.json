{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://streasoner.local/schemas/reference_data_contract_v1.schema.json",
  "title": "Normalized reference records for calibration",
  "$defs": {
    "manifest": {
      "type": "object",
      "required": ["domain", "source_dataset_id", "source_version", "split_policy"],
      "properties": {
        "domain": {"type": "string", "minLength": 1},
        "source_dataset_id": {"type": "string", "minLength": 1},
        "source_version": {"type": "string", "minLength": 1},
        "split_policy": {
          "type": "object",
          "required": ["unit", "assignment_method"],
          "properties": {
            "unit": {"enum": ["context", "time_block"]},
            "assignment_method": {"type": "string", "minLength": 1},
            "allow_overlapping_windows": {"type": "boolean"}
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "window": {
      "type": "object",
      "required": ["window_id", "context_id", "domain", "start_time", "duration_seconds", "split"],
      "properties": {
        "window_id": {"type": "string", "minLength": 1},
        "context_id": {"type": "string", "minLength": 1},
        "domain": {"type": "string", "minLength": 1},
        "start_time": {"type": "string", "minLength": 1},
        "duration_seconds": {"type": "number", "exclusiveMinimum": 0},
        "split": {"enum": ["train", "validation", "holdout"]},
        "attributes": {"type": "object"},
        "provenance": {"type": "object"}
      },
      "additionalProperties": false
    },
    "event": {
      "type": "object",
      "required": ["source_record_id", "window_id", "context_id", "domain", "event_type_id", "occurrence_offset_seconds", "participants"],
      "properties": {
        "source_record_id": {"type": "string", "minLength": 1},
        "window_id": {"type": "string", "minLength": 1},
        "context_id": {"type": "string", "minLength": 1},
        "domain": {"type": "string", "minLength": 1},
        "event_type_id": {"type": "string", "minLength": 1},
        "occurrence_offset_seconds": {"type": "number", "minimum": 0},
        "observed_at_offset_seconds": {"type": ["number", "null"], "minimum": 0},
        "recorded_at_offset_seconds": {"type": ["number", "null"], "minimum": 0},
        "participants": {"type": "array", "minItems": 1},
        "attributes": {"type": "object"},
        "explicit_parent_record_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "relation_or_trace_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "context_state_snapshot": {"type": "object"},
        "provenance": {"type": "object"}
      },
      "additionalProperties": false
    }
  },
  "oneOf": [
    {"$ref": "#/$defs/manifest"},
    {"$ref": "#/$defs/window"},
    {"$ref": "#/$defs/event"}
  ]
}
